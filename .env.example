# Rabb.ai environment variables. Names only. Never commit real values.
# Mobile app values are PUBLIC and ship in the binary. Server values live only in Supabase secrets.

# ---- Mobile app (apps/mobile/.env) ----
# Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=
# Supabase anon (publishable) key. Safe for the client because RLS protects data.
SUPABASE_ANON_KEY=
# RevenueCat public SDK keys, one per store.
REVENUECAT_IOS_PUBLIC_KEY=
REVENUECAT_ANDROID_PUBLIC_KEY=
# Sentry DSN for the mobile project.
SENTRY_DSN=
# PostHog project API key and host. Autocapture and session replay stay off.
POSTHOG_API_KEY=
POSTHOG_HOST=
# Google OAuth client IDs for native sign in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ---- Edge Functions (supabase secrets set ...) ----
# Never put these in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Provider selection. "openai" or "mock".
AI_PROVIDER=mock
OPENAI_API_KEY=
# Model names come from the environment only. Nothing is hardcoded in code.
AI_CHAT_MODEL=
AI_MODERATION_MODEL=
AI_EMBEDDING_MODEL=
# Embedding dimension must match the content_chunks vector column (see migrations).
AI_EMBEDDING_DIMENSIONS=1536
# Per user token budgets.
AI_DAILY_TOKEN_BUDGET=
AI_MONTHLY_TOKEN_BUDGET=
# RevenueCat webhook authorization secret. The function compares the Authorization header to this value.
REVENUECAT_WEBHOOK_SECRET=
# Premium entitlement identifier configured in RevenueCat.
REVENUECAT_ENTITLEMENT_ID=Rabb.ai Premium

# ---- CI and tooling ----
# Supabase access token for CI (db lint and functions deploy).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Sentry upload credentials for release builds.
SENTRY_AUTH_TOKEN=
