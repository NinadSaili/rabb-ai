{
  "name": "rabb-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:reset": "bash scripts/db-reset.sh",
    "db:test": "bash scripts/db-test.sh",
    "functions:test": "bash scripts/functions-test.sh",
    "ai:evals": "bash scripts/ai-evals.sh",
    "docs:api": "tsx scripts/generate-api-spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "deno": "^2.1.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "zod-to-json-schema": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "deno",
      "esbuild"
    ]
  },
  "type": "module"
}
